{
    "kopf-anzeige": {
        "type": "header",
        "description": "Hover-Anzeige"
    },
    "refresh-interval": {
        "type": "spinbutton",
        "default": 3,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "Sekunden",
        "description": "Aktualisierungsintervall",
        "tooltip": "Der Takt richtet sich nach der Systemuhr. Stehen Applet und Desklet auf demselben Intervall, messen und aktualisieren beide im selben Moment."
    },
    "popup-height-ratio": {
        "type": "scale",
        "default": 70,
        "min": 40,
        "max": 90,
        "step": 5,
        "digits": 0,
        "units": "%",
        "description": "Anzeigegröße",
        "tooltip": "Anteil der Bildschirmhöhe, den die Hover-Anzeige einnimmt. Schriftgröße und Spaltenbreiten werden daraus und aus der Anzahl der angezeigten Messwerte berechnet."
    },
    "popup-opacity": {
        "type": "scale",
        "default": 55,
        "min": 45,
        "max": 85,
        "step": 5,
        "digits": 0,
        "units": "%",
        "description": "Deckkraft der Hintergrundfläche",
        "tooltip": "Je höher der Wert, desto dunkler die Fläche hinter der Anzeige. Werte unter 45 Prozent sind nicht wählbar, da die weiße Schrift auf hellem Bildschirminhalt sonst nicht mehr ausreichend lesbar ist."
    },
    "kopf-panel": {
        "type": "header",
        "description": "Panel"
    },
    "panel-symbol": {
        "type": "combobox",
        "default": "icon",
        "description": "Panel-Symbol",
        "tooltip": "Das farbige Logo passt zu dunklen Panels. Die einfarbigen Varianten übernehmen die Farbe des Panel-Themes und eignen sich auch für helle Panels. Größe wie Statusanzeigen reiht das Logo bei WLAN, Lautstärke und Akku ein, statt es wie ein Programmsymbol hervorzuheben.",
        "options": {
            "Logo farbig": "icon",
            "Logo einfarbig": "symbolic",
            "Logo einfarbig, Größe wie Statusanzeigen": "symbolic-status",
            "Textkürzel aVP": "text"
        }
    },
    "kopf-messwerte": {
        "type": "header",
        "description": "Angezeigte Messwerte"
    },
    "hinweis-messwerte": {
        "type": "label",
        "description": "Sichtbar: Häkchen setzen oder entfernen. Reihenfolge: Zeile wählen und mit den Pfeilen verschieben. Eigene Bezeichnung: Doppelklick auf die Zeile; leer lassen für die Vorgabe. Messwerte ohne Sensor werden auf diesem Gerät nicht angezeigt."
    },
    "messwert-liste": {
        "type": "list",
        "description": "Messwerte",
        "height": 430,
        "hidden-buttons": [
            "+",
            "-"
        ],
        "columns": [
            {
                "id": "messwert",
                "title": "Messwert",
                "type": "string",
                "options": {
                    "CPU-Temperatur  (Vorgabe: CPU)": "cpu_temp",
                    "CPU-Auslastung  (Vorgabe: LOAD)": "cpu_load",
                    "RAM-Auslastung  (Vorgabe: RAM)": "ram_load",
                    "Speicher-Temperatur  (Vorgabe: SSD)": "storage_temp",
                    "Freier Speicherplatz  (Vorgabe: FREE ⛁)": "storage_free",
                    "Lüfterdrehzahl  (Vorgabe: FAN)": "fan_speed",
                    "Akku-Ladezustand  (Vorgabe: BATT)": "battery_charge",
                    "Netzteil  (Vorgabe: STATUS)": "psu_state",
                    "Netzwerk Download  (Vorgabe: DOWN)": "net_down",
                    "Netzwerk Upload  (Vorgabe: UP)": "net_up",
                    "Speedtest Download  (Vorgabe: SPEED ↓)": "speed_down",
                    "Speedtest Upload  (Vorgabe: SPEED ↑)": "speed_up",
                    "Ping  (Vorgabe: PING)": "ping",
                    "Jitter  (Vorgabe: JITTER)": "jitter",
                    "Alter des Speedtests  (Vorgabe: LAST ◷)": "speed_age"
                }
            },
            {
                "id": "bezeichnung",
                "title": "Eigene Bezeichnung",
                "type": "string",
                "default": "",
                "align": 0.5
            },
            {
                "id": "sichtbar",
                "title": "Sichtbar",
                "type": "boolean",
                "default": true,
                "align": 0.5
            }
        ],
        "default": [
            {
                "messwert": "cpu_temp",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "cpu_load",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "ram_load",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "storage_temp",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "storage_free",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "fan_speed",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "battery_charge",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "psu_state",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "net_down",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "net_up",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "speed_down",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "speed_up",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "ping",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "jitter",
                "bezeichnung": "",
                "sichtbar": true
            },
            {
                "messwert": "speed_age",
                "bezeichnung": "",
                "sichtbar": true
            }
        ]
    },
    "kopf-sensoren": {
        "type": "header",
        "description": "Sensoren"
    },
    "hinweis-sensoren": {
        "type": "label",
        "description": "„Automatisch“ wählt den passenden Sensor selbst. Die Auswahl zeigt alle Sensoren dieses Geräts mit dem Wert zum Zeitpunkt der Erkennung. Nach „Hardware neu erkennen“ wird die Auswahl aktualisiert."
    },
    "sensor-cpu": {
        "type": "combobox",
        "default": "auto",
        "description": "CPU-Temperatur",
        "options": {
            "Automatisch": "auto"
        }
    },
    "sensor-storage": {
        "type": "combobox",
        "default": "auto",
        "description": "Speicher-Temperatur",
        "options": {
            "Automatisch": "auto"
        }
    },
    "sensor-fan": {
        "type": "combobox",
        "default": "auto",
        "description": "Lüfter",
        "options": {
            "Automatisch": "auto"
        }
    },
    "kopf-quellen": {
        "type": "header",
        "description": "Netzwerk und Speicherplatz"
    },
    "hinweis-quellen": {
        "type": "label",
        "description": "Bestimmt, welche Netzwerkschnittstelle DOWN/UP und welches Laufwerk FREE anzeigt. Angeboten werden nur lokale Laufwerke; Netzlaufwerke nicht, da ein nicht erreichbares Netzlaufwerk die Oberfläche blockieren könnte. Ein neu eingesteckter USB-Stick erscheint nach „Hardware neu erkennen“."
    },
    "netz-schnittstelle": {
        "type": "combobox",
        "default": "auto",
        "description": "Netzwerkschnittstelle",
        "options": {
            "Automatisch": "auto"
        }
    },
    "laufwerk-free": {
        "type": "combobox",
        "default": "auto",
        "description": "Laufwerk für FREE",
        "options": {
            "Automatisch": "auto"
        }
    },
    "kopf-speedtest": {
        "type": "header",
        "description": "Internet-Speedtest"
    },
    "hinweis-speedtest": {
        "type": "label",
        "description": "Ein Klick auf das Panel-Symbol startet den Speedtest."
    },
    "btn-speedtest": {
        "type": "button",
        "description": "Speedtest jetzt starten",
        "callback": "on_speedtest_starten",
        "tooltip": "Der Test dauert etwa 20 Sekunden. Das Ergebnis wird gespeichert und steht auch der jeweils anderen Komponente zur Verfügung."
    },
    "btn-berichte-speedtest": {
        "type": "button",
        "description": "Speedtest-Berichte öffnen",
        "callback": "on_berichte_speedtest_oeffnen",
        "tooltip": "Öffnet den Ordner mit den Speedtest-Berichten. Jede Messung legt dort eine eigene Datei mit Datum und Uhrzeit ab."
    },
    "kopf-hardware": {
        "type": "header",
        "description": "Hardware"
    },
    "btn-hardware-neu": {
        "type": "button",
        "description": "Hardware neu erkennen",
        "callback": "on_hardware_neu_erkennen",
        "tooltip": "Sucht die Sensoren erneut. Nötig nach einem Hardwarewechsel, etwa einer neuen SSD, oder wenn ein Messwert fehlt, weil sein Treiber beim Start noch nicht geladen war. Ein Neustart von Cinnamon ist dafür nicht erforderlich. Findet die Erkennung neue oder entfernte Sensoren, Schnittstellen oder Laufwerke, wirst du gefragt, ob dieses Fenster zum Aktualisieren der Auswahl kurz geschlossen und an derselben Stelle neu geöffnet werden soll. Ohne deine Zustimmung wird kein Fenster geschlossen."
    },
    "hinweis-hardware-neu": {
        "type": "label",
        "description": "Findet die Erkennung neue oder entfernte Sensoren, Schnittstellen oder Laufwerke, wirst du gefragt, ob dieses Fenster zum Aktualisieren der Auswahl kurz geschlossen und an derselben Stelle neu geöffnet werden soll. Ohne deine Zustimmung wird kein Fenster geschlossen."
    },
    "btn-berichte-hardware": {
        "type": "button",
        "description": "Hardware-Berichte öffnen",
        "callback": "on_berichte_hardware_oeffnen",
        "tooltip": "Öffnet den Ordner mit den Hardwareberichten. Jede Erkennung legt dort eine eigene Datei mit Datum und Uhrzeit ab."
    },
    "kopf-zuruecksetzen": {
        "type": "header",
        "description": "Zurücksetzen"
    },
    "btn-standardwerte": {
        "type": "button",
        "description": "Auf Standardwerte zurücksetzen",
        "callback": "on_standardwerte_zuruecksetzen",
        "tooltip": "Setzt Aktualisierungsintervall, Anzeigegröße, Deckkraft und Panel-Symbol auf die Auslieferungswerte zurück."
    }
}
