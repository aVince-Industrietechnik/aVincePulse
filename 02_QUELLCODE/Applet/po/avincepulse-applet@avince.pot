msgstr ""

#. metadata.json->description
msgid ""
"Hardware and network monitor for the Cinnamon panel, with a large hover "
"display."
msgstr ""

#. settings-schema.json->kopf-anzeige->description
msgid "Hover display"
msgstr ""

#. settings-schema.json->refresh-interval->units
msgid "seconds"
msgstr ""

#. settings-schema.json->refresh-interval->description
msgid "Update interval"
msgstr ""

#. settings-schema.json->refresh-interval->tooltip
msgid ""
"The interval follows the system clock. With applet and desklet set to the "
"same interval, both measure and update at the same moment."
msgstr ""

#. settings-schema.json->popup-height-ratio->units
#. settings-schema.json->popup-opacity->units
msgid "%"
msgstr ""

#. settings-schema.json->popup-height-ratio->description
msgid "Display size"
msgstr ""

#. settings-schema.json->popup-height-ratio->tooltip
msgid ""
"How much of the screen height the hover display takes up. Font size and "
"column widths are derived from this and from the number of values shown."
msgstr ""

#. settings-schema.json->popup-opacity->description
msgid "Background panel"
msgstr ""

#. settings-schema.json->popup-opacity->tooltip
msgid ""
"Opacity of the panel behind the display. At 0 per cent the display has no "
"panel at all. Higher values darken it. Over light screen content it turns "
"mid-grey, which costs the warning colours contrast; at high opacity the "
"muted colour set works better."
msgstr ""

#. settings-schema.json->linksklick-aktion->description
msgid "Left-click action"
msgstr ""

#. settings-schema.json->linksklick-aktion->options
msgid "Toggle the display"
msgstr ""

#. settings-schema.json->linksklick-aktion->options
msgid "Open the system monitor"
msgstr ""

#. settings-schema.json->linksklick-aktion->options
msgid "Nothing"
msgstr ""

#. settings-schema.json->linksklick-aktion->tooltip
msgid ""
"“Toggle the display” keeps the values on screen after a click until you "
"click again, click elsewhere or press Esc. This mainly helps on a "
"touchscreen, where there is no hovering. It does not start the speed test — "
"that lives in the right-click menu."
msgstr ""

#. settings-schema.json->kopf-panel->description
msgid "Panel"
msgstr ""

#. settings-schema.json->panel-symbol->description
msgid "Panel icon"
msgstr ""

#. settings-schema.json->panel-symbol->tooltip
msgid ""
"The colour logo suits dark panels. The single-colour variants take the "
"colour of the panel theme and work on light panels too. Status icon size "
"lines the logo up with Wi-Fi, volume and battery instead of making it stand "
"out like an application icon."
msgstr ""

